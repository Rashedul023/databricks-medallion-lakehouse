{
  "name": "ecom_medallion_pipeline",
  "max_concurrent_runs": 1,
  "queue": { "enabled": true },
  "email_notifications": { "on_failure": ["YOUR_EMAIL@example.com"] },
  "tasks": [
    {
      "task_key": "bronze",
      "notebook_task": {
        "notebook_path": "/Workspace/Users/YOUR_EMAIL@example.com/databricks-medallion-lakehouse/notebooks/01_bronze",
        "base_parameters": { "catalog": "workspace", "batch_id": "batch_001" }
      },
      "max_retries": 2,
      "min_retry_interval_millis": 60000
    },
    {
      "task_key": "silver",
      "depends_on": [{ "task_key": "bronze" }],
      "notebook_task": {
        "notebook_path": "/Workspace/Users/YOUR_EMAIL@example.com/databricks-medallion-lakehouse/notebooks/03_silver",
        "base_parameters": { "catalog": "workspace" }
      },
      "max_retries": 1,
      "min_retry_interval_millis": 60000
    },
    {
      "task_key": "reconcile",
      "depends_on": [{ "task_key": "silver" }],
      "notebook_task": {
        "notebook_path": "/Workspace/Users/YOUR_EMAIL@example.com/databricks-medallion-lakehouse/notebooks/04_reconciliation",
        "base_parameters": { "catalog": "workspace" }
      },
      "max_retries": 0
    },
    {
      "task_key": "gold",
      "depends_on": [{ "task_key": "reconcile" }],
      "notebook_task": {
        "notebook_path": "/Workspace/Users/YOUR_EMAIL@example.com/databricks-medallion-lakehouse/notebooks/05_gold",
        "base_parameters": { "catalog": "workspace" }
      },
      "max_retries": 1,
      "min_retry_interval_millis": 60000
    }
  ]
}
